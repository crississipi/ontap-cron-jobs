{
  "name": "ontap-cron-jobs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate && prisma generate --schema=prisma/analytics.prisma",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cloudinary": "^2.10.0",
    "mysql2": "^3.22.2",
    "next": "16.2.12",
    "nodemailer": "^9.0.1",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.12"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "^8.5.18",
    "sharp": "0.35.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
