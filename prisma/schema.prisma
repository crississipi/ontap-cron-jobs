/// Temporary checkout session — stores cart snapshot before payment
/// Only created on checkout, deleted when order is confirmed or session expires (24h)
model CheckoutSession {
  id                BigInt     @id @default(autoincrement())
  /// UUID session token for post-payment redirect
  session_id        String     @unique @db.VarChar(100)
  user_id           BigInt
  /// Snapshot of cart items at checkout time
  cart_snapshot     String     @db.LongText
  /// Pre-calculated line items (product price from DB)
  line_items        String     @db.LongText
  subtotal          Decimal    @db.Decimal(10, 2)
  discount_amount   Decimal    @default(0.00) @db.Decimal(10, 2)
  tax_amount        Decimal    @default(0.00) @db.Decimal(10, 2)
  shipping_amount   Decimal    @default(0.00) @db.Decimal(10, 2)
  total_amount      Decimal    @db.Decimal(10, 2)
  /// Fixed to PHP
  currency          String     @default("PHP") @db.VarChar(3)
  promo_code        String?    @db.VarChar(50)
  promo_id          BigInt?
  /// Xendit invoice ID
  invoice_id        String?    @db.VarChar(255)
  /// ShopOrder ID once payment succeeds
  order_id          BigInt?
  /// pending, completed, expired, failed
  status            String     @default("pending") @db.VarChar(20)
  /// Shipping address JSON
  shipping_address  String?    @db.LongText
  /// Billing address JSON
  billing_address   String?    @db.LongText
  payment_method_id String?    @db.VarChar(50)
  notes             String?    @db.Text
  created_at        DateTime   @default(now())
  /// 24h expiry
  expires_at        DateTime
  updated_at        DateTime   @updatedAt
  order             ShopOrder? @relation(fields: [order_id], references: [id])
  promo             Promotion? @relation(fields: [promo_id], references: [id])
  user              User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([session_id])
  @@index([user_id])
  @@index([invoice_id])
  @@index([order_id])
  @@index([status, expires_at])
  @@index([status, user_id])
  @@index([promo_id], map: "checkout_sessions_promo_id_fkey")
  @@map("checkout_sessions")
}

