  xendit_invoice_url    String?                  @db.VarChar(500)
  xendit_payment_id     String?                  @db.VarChar(255)
  xendit_status         String?                  @db.VarChar(50)
  xendit_payment_method String?                  @db.VarChar(100)
  feedback              OrderFeedback?
  statusAuditLogs       OrderStatusAuditLog[]
  statusCache           OrderStatusCache?
  purchaseLogs          PurchaseLog[]
  shopCommissions       ShopCommission[]
  promo                 Promotion?               @relation(fields: [promo_id], references: [id])
  statusChangedBy       User?                    @relation("ShopOrderStatusChangedBy", fields: [status_changed_by], references: [user_id])
  user                  User                     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  items                 ShopOrderItem[]
  spinAwards            SpinHistory[]
  upgradeLogs           SubscriptionUpgradeLog[]
  templatePurchases     TemplatePurchase[]
  checkoutSessions      CheckoutSession[]

  @@index([user_id, placed_at])
  @@index([status, placed_at])
  @@index([xendit_invoice_id])
  @@index([xendit_payment_id])
  @@index([tracking_number])
  @@index([status_changed_by], map: "ShopOrder_status_changed_by_fkey")
  @@index([order_number])
  @@index([promo_id], map: "ShopOrder_promo_id_fkey")
}

/// One-time post-purchase feedback invitation (emailed after completed/delivered).
model OrderFeedback {
  id              BigInt    @id @default(autoincrement())
  uuid            String    @unique @db.VarChar(36)
  order_id        BigInt    @unique
  user_id         BigInt
  status          String    @default("pending") @db.VarChar(20)
  overall_rating  Int?
  product_rating  Int?
  delivery_rating Int?
  recommend       Boolean?
  message         String?   @db.Text
  email_sent_at   DateTime?
  submitted_at    DateTime?
  expires_at      DateTime
  created_at      DateTime  @default(now())
  updated_at      DateTime?
  order           ShopOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([status, email_sent_at])
  @@index([expires_at])
}

model OrderStatusAuditLog {
  log_id          BigInt    @id @default(autoincrement())
  order_id        BigInt
  previous_status String?   @db.VarChar(20)
  next_status     String    @db.VarChar(20)
  reason          String?   @db.Text
  changed_by      BigInt
  request_id      String?   @db.VarChar(100)
  ip_address      String?   @db.VarChar(45)
  user_agent      String?   @db.Text
  metadata        String?   @db.LongText
  changed_at      DateTime  @default(now())
  actor           User      @relation("OrderStatusAuditActor", fields: [changed_by], references: [user_id], onDelete: Cascade)
  order           ShopOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, changed_at])
  @@index([changed_by])
  @@index([next_status])
}

model DevIncident {
  incident_id              BigInt            @id @default(autoincrement())
  incident_key             String            @unique @db.VarChar(64)
  title                    String            @db.VarChar(255)
  status                   String            @default("open") @db.VarChar(30)
  severity                 String            @default("medium") @db.VarChar(20)
  source_type              String?           @db.VarChar(30)
  route_key                String?           @db.VarChar(255)
  first_seen_at            DateTime
  last_seen_at             DateTime
  occurrence_count         Int               @default(0)
  affected_users_count     Int               @default(0)
  affected_companies_count Int               @default(0)
  owner_user_id            BigInt?
  resolution_note          String?           @db.Text
  resolved_at              DateTime?
  created_at               DateTime          @default(now())
  updated_at               DateTime?         @updatedAt
  owner                    User?             @relation("DevIncidentOwner", fields: [owner_user_id], references: [user_id])
  links                    DevIncidentLink[]

  @@index([status, severity])
  @@index([last_seen_at])
  @@index([owner_user_id])
}

model DevIncidentLink {
  link_id       BigInt      @id @default(autoincrement())
  incident_id   BigInt
  entity_type   String      @db.VarChar(50)
  entity_id     String      @db.VarChar(128)
  relation_type String      @default("detected") @db.VarChar(30)
  metadata      String?     @db.LongText
  created_at    DateTime    @default(now())
  incident      DevIncident @relation(fields: [incident_id], references: [incident_id], onDelete: Cascade)

  @@unique([incident_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
}

model DevFeatureFlag {
  feature_flag_id BigInt    @id @default(autoincrement())
  flag_key        String    @unique @db.VarChar(64)
  label           String    @db.VarChar(120)
  description     String?   @db.Text
  scope           String    @default("global") @db.VarChar(30)
  enabled         Boolean   @default(false)
  note            String?   @db.Text
  updated_by      BigInt?
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  updater         User?     @relation("DevFeatureFlagUpdater", fields: [updated_by], references: [user_id])

  @@index([scope, enabled])
  @@index([updated_by])
}

model DevIntegrityCheckResult {
  check_result_id BigInt   @id @default(autoincrement())
  check_key       String   @db.VarChar(80)
  status          String   @db.VarChar(20)
  issue_count     Int      @default(0)
  summary         String?  @db.Text
  details         String?  @db.LongText
  created_by      BigInt?
  created_at      DateTime @default(now())
  actor           User?    @relation("DevIntegrityCheckActor", fields: [created_by], references: [user_id])

  @@index([check_key, created_at])
  @@index([status, created_at])
  @@index([created_by])
}

/// Platform notice-board posts composed in the Developer Portal.
model DevNotice {
  notice_id      BigInt    @id @default(autoincrement())
  public_id      String    @unique @db.VarChar(40)
  title          String    @db.VarChar(200)
  summary        String?   @db.VarChar(320)
  body           String    @db.Text
  notice_type    String    @db.VarChar(32)
  status         String    @default("draft") @db.VarChar(20)
  priority       String    @default("medium") @db.VarChar(16)
  /// JSON string array of portals: user | admin | staff
  portals        String    @db.Text
  /// JSON string array of surface placements (dashboard, emarket, …)
  placements     String    @db.Text
  /// JSON string array of audience segments (role_*, tier_*, new_users, …)
  audiences      String    @db.Text
  /// JSON string array of channels: in_app | email
  channels       String    @db.Text
  cta_label      String?   @db.VarChar(80)
  cta_url        String?   @db.VarChar(512)
  survey_url     String?   @db.VarChar(512)
  /// JSON string arrays for What's New changelog sections
  whats_new_added   String? @db.LongText
  whats_new_fixed   String? @db.LongText
  whats_new_removed String? @db.LongText
  /// JSON SurveyQuestion[] for in-app survey builder
  survey_questions  String? @db.LongText
  /// JSON string[] of specific user_id targets (optional allow-list)
  target_user_ids   String? @db.Text
  /// JSON string[] of media URLs for promotion creatives
  media_urls        String? @db.LongText
  accent_color   String?   @db.VarChar(16)
  starts_at      DateTime?
  ends_at        DateTime?
  published_at   DateTime?
  notified_at    DateTime?
  notify_in_app  Int       @default(0)
  notify_email   Int       @default(0)
  notify_skipped Int       @default(0)
  created_by     BigInt?
  updated_by     BigInt?
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?
  creator        User?     @relation("DevNoticeCreator", fields: [created_by], references: [user_id])
  updater        User?     @relation("DevNoticeUpdater", fields: [updated_by], references: [user_id])
  surveyResponses DevSurveyResponse[]

  @@index([status, notice_type])
  @@index([published_at])
  @@index([deleted_at])
  @@index([created_by])
  @@map("DevNotice")
}

model DevSurveyResponse {
  response_id BigInt   @id @default(autoincrement())
  notice_id   BigInt
  user_id     BigInt
  answers     String   @db.LongText
  created_at  DateTime @default(now())
  notice      DevNotice @relation(fields: [notice_id], references: [notice_id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([notice_id, user_id])
  @@index([notice_id])
  @@index([user_id])
  @@map("DevSurveyResponse")
}

model OrderStatusCache {
  cache_id          BigInt    @id @default(autoincrement())
  order_id          BigInt    @unique
  order_number      String    @unique @db.VarChar(50)
  user_id           BigInt
  status            String    @db.VarChar(20)
  previous_status   String?   @db.VarChar(20)
  status_changed_at DateTime
