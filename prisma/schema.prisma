generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("NEWDATABASE_URL")
}

model Company {
  company_id                 BigInt                      @id @default(autoincrement())
  name                       String                      @db.VarChar(255)
  security_key               String                      @db.VarChar(255)
  admin_id                   BigInt?
  company_slug               String?                     @unique @db.VarChar(255)
  security_code              String?                     @db.VarChar(8)
  approval_required          Boolean                     @default(true)
  is_public                  Boolean                     @default(false)
  company_theme              String?                     @default("default") @db.VarChar(100)
  settings                   String?                     @db.LongText
  status                     String                      @default("pending") @db.VarChar(20)
  subscription_tier          String?                     @db.VarChar(20)
  max_employees              Int?
  current_employees          Int                         @default(0)
  created_by                 BigInt?
  approved_at                DateTime?
  approved_by                BigInt?
  last_name_change_request   DateTime?
  pending_name_change        String?                     @db.VarChar(255)
  rejection_reason           String?                     @db.Text
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime?
  description                String?                     @db.Text
  email                      String?                     @unique
  logo_url                   String?                     @db.VarChar(512)
  bizcards                   Bizcard[]
  admin                      User?                       @relation("CompanyAdmin", fields: [admin_id], references: [user_id])
  approvedByUser             User?                       @relation("CompanyApprovedBy", fields: [approved_by], references: [user_id])
  createdByUser              User?                       @relation("CompanyCreatedBy", fields: [created_by], references: [user_id])
  companyAuditLogs           CompanyAuditLog[]
  companyEmployees           CompanyEmployee[]
  companyEmployeeInvitations CompanyEmployeeInvitation[]
  companyJoinRequests        CompanyJoinRequest[]
  companyNameChangeRequests  CompanyNameChangeRequest[]
  employeeCards              EmployeeCard[]
  groups                     Group[]
  staffClientAssignments     StaffClientAssignment[]
  users                      User[]                      @relation("CompanyMembers")
  User_new                   User_new[]

  @@index([status])
  @@index([subscription_tier])
  @@index([created_by])
  @@index([approved_by])
  @@index([admin_id], map: "Company_admin_id_fkey")
}

model Group {
  group_id   BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  company_id BigInt
  user_id    BigInt?
  created_at DateTime  @default(now())
  updated_at DateTime?
  company    Company   @relation(fields: [company_id], references: [company_id])
  user       User?     @relation(fields: [user_id], references: [user_id])

  @@index([company_id], map: "Group_company_id_fkey")
  @@index([user_id], map: "Group_user_id_fkey")
}

model User {
  user_id                            BigInt                            @id @default(autoincrement())
  serial_id                          String?                           @unique @db.VarChar(100)
  custom_uri                         String?                           @unique
  role                               String                            @db.VarChar(50)
  staff_designation                  String?                           @db.VarChar(100)
  first_name                         String                            @db.VarChar(100)
  last_name                          String                            @db.VarChar(100)
  middle_name                        String?                           @db.VarChar(100)
  email                              String                            @unique
  contact                            String?                           @db.VarChar(20)
  alt_contact                        String?                           @db.VarChar(20)
  alt_email                          String?
  about                              String?                           @db.Text
  job_position                       String?                           @db.VarChar(100)
  affiliate_code                     String?                           @db.VarChar(50)
  is_affiliate                       Boolean                           @default(false)
  commission_rate                    Decimal                           @default(10.00) @db.Decimal(5, 2)
  affiliate_joined_at                DateTime?
  is_affiliate_restricted            Boolean                           @default(false)
  affiliate_restricted_until         DateTime?
  affiliate_restriction_reason       String?                           @db.Text
  affiliate_restricted_by            BigInt?
  affiliate_restricted_at            DateTime?
  total_affiliate_earnings           Decimal                           @default(0.00) @db.Decimal(12, 2)
  total_successful_referrals         Int                               @default(0)
  prof_title                         String?                           @db.VarChar(20)
  post_nominal                       String?                           @db.VarChar(20)
  suffix                             String?                           @db.VarChar(10)
  profile_url                        String?                           @db.VarChar(512)
  cover_url                          String?                           @db.VarChar(512)
  location                           String?                           @db.VarChar(255)
  two_factor_secret                  String?                           @db.LongText
  two_factor_enabled                 Boolean                           @default(false)
  auto_logout_minutes                Int                               @default(1440)
  login_notifications                Boolean                           @default(true)
  password_rotation_days             Int                               @default(30)
  suspicious_ips                     String?                           @db.LongText
  company_id                         BigInt?
  group_id                           BigInt?
  linked_account                     BigInt?
  is_active                          Boolean                           @default(true)
  is_restricted                      Boolean                           @default(false)
  restricted_until                   DateTime?
  restriction_reason                 String?                           @db.Text
  restricted_by                      BigInt?
  restricted_at                      DateTime?
  is_online                          Boolean                           @default(false)
  last_active                        DateTime?
  deactivated_flag                   Boolean                           @default(false)
  last_login_at                      DateTime?
  last_login_ip                      String?                           @db.VarChar(45)
  last_login_location                String?                           @db.VarChar(255)
  last_login_latitude                Decimal?                          @db.Decimal(10, 8)
  last_login_longitude               Decimal?                          @db.Decimal(11, 8)
  last_login_country                 String?                           @db.VarChar(100)
  last_login_city                    String?                           @db.VarChar(100)
  registration_ip                    String?                           @db.VarChar(45)
  registration_location              String?                           @db.VarChar(255)
  registration_latitude              Decimal?                          @db.Decimal(10, 8)
  registration_longitude             Decimal?                          @db.Decimal(11, 8)
  registration_country               String?                           @db.VarChar(100)
  registration_city                  String?                           @db.VarChar(100)
  is_trial_used                      Boolean                           @default(false)
  trial_start                        DateTime?
  trial_end                          DateTime?
  spin_balance                       Int                               @default(0)
  total_spins_earned                 Int                               @default(0)
  total_spins_used                   Int                               @default(0)
  last_spin_at                       DateTime?
  created_at                         DateTime                          @default(now())
  updated_at                         DateTime?
  registration_type                  String                            @default("individual") @db.VarChar(20)
  can_create_company                 Boolean                           @default(false)
  last_reverification_at             DateTime?
  /// Soft-delete timestamp; set when Super Admin moves the user to Recycle Bin
  deleted_at                         DateTime?
  activityLogs                       ActivityLog[]
  addresses                          Address[]
  adminAuditLogs                     AdminAuditLog[]
  affiliates                         Affiliate[]
  affiliateAuditLogs                 AffiliateAuditLog[]               @relation("AffiliateAuditSubject")
  performedAffiliateAuditLogs        AffiliateAuditLog[]               @relation("AffiliateAuditPerformer")
  affiliateClicks                    AffiliateClick[]                  @relation("AffiliateClicksOwner")
  affiliateConversions               AffiliateClick[]                  @relation("AffiliateClicksConversionUser")
  affiliateLinks                     AffiliateLink[]                   @relation("AffiliateLinksOwner")
  affiliatePerformanceMetrics        AffiliatePerformanceMetric[]      @relation("AffiliatePerformanceOwner")
  affiliateSettings                  AffiliateSettings?
  claimedBlankBizcards               Bizcard[]                         @relation("BizcardClaimedBy")
  generatedBlankBizcards             Bizcard[]                         @relation("BizcardGeneratedBy")
  bizcards                           Bizcard[]
  bizcardMergeHistory                BizcardMergeHistory[]
  blocksReceived                     BlockedUser[]                     @relation("BlockedTargetUser")
  blocksInitiated                    BlockedUser[]                     @relation("BlockedByUser")
  blogs                              Blog[]
  carts                              Cart?
  cartItems                          CartItem[]
  clientAuditLogs                    ClientAuditLog[]                  @relation("ClientAuditClient")
  performedClientAuditLogs           ClientAuditLog[]                  @relation("ClientAuditPerformer")
  commissionsAsAffiliate             Commission[]                      @relation("CommissionsAffiliateUser")
  commissionsAsReferred              Commission[]                      @relation("CommissionsReferredUser")
  companiesManaged                   Company[]                         @relation("CompanyAdmin")
  companiesApproved                  Company[]                         @relation("CompanyApprovedBy")
  companiesCreated                   Company[]                         @relation("CompanyCreatedBy")
  companyAuditLogs                   CompanyAuditLog[]
  companyEmployeeRecords             CompanyEmployee[]
  companyEmployeeInvitationsSent     CompanyEmployeeInvitation[]       @relation("CompanyEmployeeInvitationInviter")
  companyEmployeeInvitationsReceived CompanyEmployeeInvitation[]       @relation("CompanyEmployeeInvitationUser")
  companyJoinReviews                 CompanyJoinRequest[]              @relation("CompanyJoinRequestReviewer")
  companyJoinRequests                CompanyJoinRequest[]              @relation("CompanyJoinRequestUser")
  companyNameChangeRequests          CompanyNameChangeRequest[]        @relation("CompanyNameChangeRequester")
  companyNameChangeReviews           CompanyNameChangeRequest[]        @relation("CompanyNameChangeReviewer")
  receivedConnections                Connection[]                      @relation("ConnectionRecipient")
  sentConnections                    Connection[]                      @relation("ConnectionRequester")
  connectionTagsTarget               ConnectionTag[]                   @relation("ConnectionTagsTarget")
  connectionTagsOwned                ConnectionTag[]                   @relation("ConnectionTagsOwner")
  credentials                        Credential?
  updatedDevFeatureFlags             DevFeatureFlag[]                  @relation("DevFeatureFlagUpdater")
  ownedDevIncidents                  DevIncident[]                     @relation("DevIncidentOwner")
  createdDevIntegrityCheckResults    DevIntegrityCheckResult[]         @relation("DevIntegrityCheckActor")
  createdDevNotices                  DevNotice[]                       @relation("DevNoticeCreator")
  updatedDevNotices                  DevNotice[]                       @relation("DevNoticeUpdater")
  surveyResponses                    DevSurveyResponse[]
  deviceUsagePrimary                 DeviceUsage?                      @relation("DeviceUsagePrimary")
  emailOtps                          EmailOtp[]
  emailVerificationTokens            EmailVerificationToken[]
  employeeCard                       EmployeeCard?
  managedGroups                      Group[]
  inquiriesAssigned                  Inquiry[]                         @relation("InquiryAssignedStaff")
  sentInquiries                      Inquiry[]                         @relation("InquirySender")
  inquiries                          Inquiry[]                         @relation("InquiryOwner")
  leads                              Lead[]
  marketingEmailCampaigns            MarketingEmailCampaign[]          @relation("MarketingEmailCampaignCreatedBy")
  media                              Media[]
  notifications                      Notification?
  notificationEmailQueue             NotificationEmailQueue[]
  notificationEvents                 NotificationEvent[]
  notificationPreference             NotificationPreference?
  orderFeedbackEntries               OrderFeedback[]
  performedOrderStatusAudits         OrderStatusAuditLog[]             @relation("OrderStatusAuditActor")
  orderStatusCaches                  OrderStatusCache[]
  passwordResetTokens                PasswordResetToken[]
  payouts                            Payout[]
  permissions                        Permission?
  phoneVerificationTokens            PhoneVerificationToken[]
  products                           Product[]
  promoUsageEntries                  PromoUsage[]
  createdPromotions                  Promotion[]                       @relation("PromotionCreatedBy")
  purchaseLogs                       PurchaseLog[]
  referralsAsAffiliate               Referral[]                        @relation("ReferralsAffiliateUser")
  referredByAffiliates               Referral[]                        @relation("ReferralsReferredUser")
  services                           Service[]
  sessions                           Session[]
  shopCommissionsAsAffiliate         ShopCommission[]                  @relation("ShopCommissionsAffiliateUser")
  shopCommissionsAsReferred          ShopCommission[]                  @relation("ShopCommissionsReferredUser")
  managedShopOrders                  ShopOrder[]                       @relation("ShopOrderStatusChangedBy")
  shopOrders                         ShopOrder[]
  socials                            Social[]
  spinHistory                        SpinHistory[]
  staffClientAssignmentsClient       StaffClientAssignment[]           @relation("StaffClientAssignmentsClient")
  staffClientAssignmentsStaff        StaffClientAssignment[]           @relation("StaffClientAssignmentsStaff")
  staffMarketingActivitiesClient     StaffMarketingActivity[]          @relation("StaffMarketingActivityClient")
  staffMarketingActivitiesStaff      StaffMarketingActivity[]          @relation("StaffMarketingActivityStaff")
  impersonationAuditLogsAsSuperadmin SuperadminImpersonationAuditLog[] @relation("ImpersonationAuditSuperadmin")
  impersonationAuditLogsAsTarget     SuperadminImpersonationAuditLog[] @relation("ImpersonationAuditTarget")
  impersonationTokensAsSuperadmin    SuperadminImpersonationToken[]    @relation("ImpersonationSuperadmin")
  impersonationTokensAsTarget        SuperadminImpersonationToken[]    @relation("ImpersonationTarget")
  templatePurchases                  TemplatePurchase[]
  transactions                       Transaction[]
  affiliateRestrictedBy              User?                             @relation("AffiliateRestrictions", fields: [affiliate_restricted_by], references: [user_id])
  affiliateRestrictedUsers           User[]                            @relation("AffiliateRestrictions")
  company                            Company?                          @relation("CompanyMembers", fields: [company_id], references: [company_id])
  restrictedBy                       User?                             @relation("UserRestrictions", fields: [restricted_by], references: [user_id])
  restrictedUsers                    User[]                            @relation("UserRestrictions")
  userActivity                       UserActivity?
  triggeredNotifications             UserNotification[]                @relation("UserNotificationsTrigger")
  userNotifications                  UserNotification[]                @relation("UserNotificationsOwner")
  profileAuditActions                UserProfileAudit[]                @relation("ProfileAuditActor")
  profileAuditLogs                   UserProfileAudit[]                @relation("ProfileAuditSubject")
  vcardSetup                         VCardSetup?
  verificationCodes                  VerificationCode[]
  webauthnCredentials                WebAuthnCredential[]
  withdrawals                        Withdrawal[]                      @relation("WithdrawalsAffiliateUser")
  activeSessionEntries               ActiveSession[]
  checkoutSessions                   CheckoutSession[]
  directConversationsAsHigh          DirectConversation[]              @relation("DirectConversationUserHigh")
  directConversationsAsLow           DirectConversation[]              @relation("DirectConversationUserLow")
  directMessageHides                 DirectMessageHide[]               @relation("DirectMessageHideUser")
  directMessagesSent                 DirectMessage[]                   @relation("DirectMessageSender")
  directReadStates                   DirectParticipantReadState[]      @relation("DirectReadStateUser")
  loginHistoryEntries                LoginHistory[]
  passwordHistoryEntries             PasswordHistory[]
  paymentChannels                    PaymentChannel[]
  performedStaffActivityLogs         StaffActivityLog[]                @relation("StaffActivityActor")
  staffProfilesUpdated               StaffProfile[]                    @relation("StaffProfileUpdatedBy")
  staffProfile                       StaffProfile?                     @relation("StaffProfileUser")
  passwordViewGrantsAsSuperadmin     SuperadminPasswordViewGrant[]     @relation("PasswordViewGrantSuperadmin")
  passwordViewGrantsAsTarget         SuperadminPasswordViewGrant[]     @relation("PasswordViewGrantTarget")
  supportConversationsClaimed        SupportConversation[]             @relation("SupportConversationClaimedBy")
  supportConversationsAsClient       SupportConversation?              @relation("SupportConversationClient")
  supportConversationsEscalated      SupportConversation[]             @relation("SupportConversationEscalatedBy")
  supportConversationsResolved       SupportConversation[]             @relation("SupportConversationResolvedBy")
  supportConversationsAsStaff        SupportConversation[]             @relation("SupportConversationStaff")
  supportMessagesSent                SupportMessage[]                  @relation("SupportMessageSender")
  supportReadStates                  SupportParticipantReadState[]     @relation("SupportReadStateUser")
  cookiePreferences                  UserCookiePreferences?

  @@index([role])
  @@index([is_active, is_restricted])
  @@index([is_affiliate, is_affiliate_restricted])
  @@index([is_online, last_active])
  @@index([created_at])
  @@index([restricted_by])
  @@index([affiliate_joined_at])
  @@index([affiliate_restricted_by])
  @@index([total_affiliate_earnings])
  @@index([registration_type])
  @@index([company_id], map: "User_company_id_fkey")
  @@index([staff_designation], map: "idx_users_staff_designation")
  @@index([deleted_at])
}

model CompanyJoinRequest {
  request_id       BigInt    @id @default(autoincrement())
  company_id       BigInt
  user_id          BigInt
  status           String    @default("pending") @db.VarChar(20)
  requested_at     DateTime  @default(now())
  reviewed_at      DateTime?
  reviewed_by      BigInt?
  rejection_reason String?   @db.Text
  company          Company   @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  reviewer         User?     @relation("CompanyJoinRequestReviewer", fields: [reviewed_by], references: [user_id])
  user             User      @relation("CompanyJoinRequestUser", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([company_id, status])
  @@index([user_id])
  @@index([reviewed_by])
}

model CompanyEmployee {
  employee_id       BigInt                    @id @default(autoincrement())
  company_id        BigInt
  user_id           BigInt
  role              String                    @default("employee") @db.VarChar(20)
  permissions       String?                   @db.LongText
  joined_at         DateTime                  @default(now())
  is_active         Boolean                   @default(true)
  restricted_at     DateTime?
  restricted_reason String?                   @db.Text
  company           Company                   @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  user              User                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  activitySummaries EmployeeActivitySummary[]

  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([user_id])
  @@index([role])
}

model CompanyEmployeeInvitation {
  invitation_id BigInt    @id @default(autoincrement())
  company_id    BigInt
  email         String    @db.VarChar(255)
  user_id       BigInt?
  role          String    @default("employee") @db.VarChar(20)
  token_hash    String    @unique @db.VarChar(64)
  status        String    @default("pending") @db.VarChar(20)
  invited_by    BigInt
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime  @default(now())
  company       Company   @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  inviter       User      @relation("CompanyEmployeeInvitationInviter", fields: [invited_by], references: [user_id], onDelete: Cascade)
  user          User?     @relation("CompanyEmployeeInvitationUser", fields: [user_id], references: [user_id])

  @@index([company_id, status])
  @@index([email])
  @@index([user_id])
  @@index([invited_by])
  @@index([expires_at])
}

model EmployeeActivitySummary {
  summary_id        BigInt          @id @default(autoincrement())
  employee_id       BigInt
  period            String          @db.VarChar(20)
  period_date       DateTime        @db.Date
  profile_views     Int             @default(0)
  contact_saves     Int             @default(0)
  inquiries_count   Int             @default(0)
  connections_count Int             @default(0)
  rank_score        Decimal         @default(0.00) @db.Decimal(10, 2)
  calculated_at     DateTime        @default(now())
  employee          CompanyEmployee @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  @@unique([employee_id, period, period_date])
  @@index([period, period_date, rank_score])
}

model StaffRole {
  role_id       BigInt         @id @default(autoincrement())
  role_name     String         @unique(map: "uq_staff_roles_role_name") @db.VarChar(100)
  role_key      String         @unique(map: "uq_staff_roles_role_key") @db.VarChar(50)
  description   String?        @db.Text
  created_at    DateTime       @default(now())
  staffProfiles StaffProfile[]

  @@map("staff_roles")
}

model Department {
  department_id   BigInt         @id @default(autoincrement())
  department_name String         @unique(map: "uq_departments_department_name") @db.VarChar(100)
  department_key  String         @unique(map: "uq_departments_department_key") @db.VarChar(50)
  created_at      DateTime       @default(now())
  staffProfiles   StaffProfile[]

  @@map("departments")
}

model StaffModule {
  module_id     BigInt            @id @default(autoincrement())
  module_name   String            @unique(map: "uq_modules_module_name") @db.VarChar(100)
  module_key    String            @unique(map: "uq_modules_module_key") @db.VarChar(50)
  description   String?           @db.Text
  display_order Int               @default(0)
  created_at    DateTime          @default(now())
  permissions   StaffPermission[] @relation("StaffPermissionModule")

  @@index([display_order], map: "idx_modules_display_order")
  @@map("modules")
}

model StaffProfile {
  staff_id      BigInt             @id @default(autoincrement())
  user_id       BigInt             @unique(map: "uq_staff_profiles_user")
  role_id       BigInt
  department_id BigInt
  is_active     Boolean            @default(true)
  joined_at     DateTime           @default(now())
  updated_by    BigInt?
  updated_at    DateTime?
  activityLogs  StaffActivityLog[]
  permissions   StaffPermission[]
  department    Department         @relation(fields: [department_id], references: [department_id])
  role          StaffRole          @relation(fields: [role_id], references: [role_id])
  updatedByUser User?              @relation("StaffProfileUpdatedBy", fields: [updated_by], references: [user_id])
  user          User               @relation("StaffProfileUser", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([role_id], map: "idx_staff_profiles_role")
  @@index([department_id], map: "idx_staff_profiles_department")
  @@index([is_active], map: "idx_staff_profiles_active")
  @@index([joined_at], map: "idx_staff_profiles_joined_at")
  @@index([updated_by], map: "idx_staff_profiles_updated_by")
  @@map("staff_profiles")
}

model StaffClientAssignment {
  assignment_id  BigInt    @id @default(autoincrement())
  staff_id       BigInt
  client_user_id BigInt
  company_id     BigInt?
  assigned_at    DateTime  @default(now())
  is_primary     Boolean   @default(false)
  is_active      Boolean   @default(true)
  notes          String?   @db.Text
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  client         User      @relation("StaffClientAssignmentsClient", fields: [client_user_id], references: [user_id], onDelete: Cascade)
  company        Company?  @relation(fields: [company_id], references: [company_id])
  staff          User      @relation("StaffClientAssignmentsStaff", fields: [staff_id], references: [user_id], onDelete: Cascade)

  @@unique([staff_id, client_user_id], map: "uq_staff_client_assignments")
  @@index([staff_id], map: "idx_staff_client_assignments_staff")
  @@index([client_user_id], map: "idx_staff_client_assignments_client")
  @@index([company_id], map: "idx_staff_client_assignments_company")
}

model StaffMarketingActivity {
  activity_id BigInt   @id @default(autoincrement())
  staff_id    BigInt
  client_id   BigInt?
  action_type String   @db.VarChar(50)
  description String?  @db.Text
  metadata    String?  @db.LongText
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now())
  client      User?    @relation("StaffMarketingActivityClient", fields: [client_id], references: [user_id])
  staff       User     @relation("StaffMarketingActivityStaff", fields: [staff_id], references: [user_id], onDelete: Cascade)

  @@index([staff_id], map: "idx_staff_marketing_activity_staff")
  @@index([action_type], map: "idx_staff_marketing_activity_action")
  @@index([created_at], map: "idx_staff_marketing_activity_created_at")
  @@index([client_id], map: "StaffMarketingActivity_client_id_fkey")
}

model StaffPermission {
  permission_id BigInt       @id @default(autoincrement())
  staff_id      BigInt
  module        String       @db.VarChar(50)
  can_create    Boolean      @default(false)
  can_read      Boolean      @default(false)
  can_update    Boolean      @default(false)
  can_delete    Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime?
  moduleRef     StaffModule  @relation("StaffPermissionModule", fields: [module], references: [module_key])
  staff         StaffProfile @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)

  @@unique([staff_id, module], map: "uq_staff_permissions_staff_module")
  @@index([staff_id], map: "idx_staff_permissions_staff")
  @@index([module], map: "idx_staff_permissions_module")
  @@map("staff_permissions")
}

model StaffActivityLog {
  log_id     BigInt       @id @default(autoincrement())
  staff_id   BigInt
  user_id    BigInt
  action     String       @db.VarChar(100)
  details    String?      @db.LongText
  ip_address String?      @db.VarChar(45)
  user_agent String?      @db.Text
  request_id String?      @db.VarChar(100)
  created_at DateTime     @default(now())
  staff      StaffProfile @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)
  actor      User         @relation("StaffActivityActor", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([staff_id, created_at], map: "idx_staff_activity_staff_created")
  @@index([action], map: "idx_staff_activity_action")
  @@index([user_id], map: "idx_staff_activity_user")
  @@index([request_id], map: "idx_staff_activity_request_id")
  @@map("staff_activity_logs")
}

model CompanyNameChangeRequest {
  request_id       BigInt    @id @default(autoincrement())
  company_id       BigInt
  requested_name   String    @db.VarChar(255)
  requested_by     BigInt
  status           String    @default("pending") @db.VarChar(20)
  requested_at     DateTime  @default(now())
  reviewed_at      DateTime?
  reviewed_by      BigInt?
  rejection_reason String?   @db.Text
  company          Company   @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  requester        User      @relation("CompanyNameChangeRequester", fields: [requested_by], references: [user_id])
  reviewer         User?     @relation("CompanyNameChangeReviewer", fields: [reviewed_by], references: [user_id])

  @@index([company_id, status])
  @@index([requested_by])
  @@index([reviewed_by])
}

model CompanyAuditLog {
  log_id     BigInt   @id @default(autoincrement())
  company_id BigInt
  user_id    BigInt
  action     String   @db.VarChar(100)
  details    String?  @db.LongText
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  request_id String?  @db.VarChar(100)
  created_at DateTime @default(now())
