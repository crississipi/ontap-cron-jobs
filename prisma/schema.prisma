model Bizcard {
  bizcard_id                BigInt                   @id @default(autoincrement())
  user_id                   BigInt?
  bizcard_name              String                   @db.VarChar(255)
  serial_id                 String?                  @unique @db.VarChar(100)
  url_alias                 String?                  @unique @db.VarChar(100)
  description               String?                  @db.Text
  first_name                String                   @db.VarChar(100)
  middle_name               String?                  @db.VarChar(100)
  last_name                 String                   @db.VarChar(100)
  occupation                String?                  @db.VarChar(200)
  professional_title        String?                  @db.VarChar(200)
  post_nominal              String?                  @db.VarChar(50)
  suffix                    String?                  @db.VarChar(50)
  area                      String?                  @db.VarChar(100)
  baranggay                 String?                  @db.VarChar(100)
  city                      String                   @default("") @db.VarChar(100)
  zip_code                  BigInt?
  region                    String?                  @db.VarChar(100)
  address_link              String?                  @db.Text
  company_id                BigInt?
  bio                       String?                  @db.LongText
  email                     String                   @db.VarChar(255)
  contact_number            String                   @db.VarChar(50)
  alt_email                 String?                  @db.VarChar(255)
  alt_contact_number        String?                  @db.VarChar(50)
  languages                 String?                  @db.Text
  profile_img               String?                  @db.VarChar(500)
  cover_img                 String?                  @db.VarChar(500)
  cover_img_position        String?                  @db.VarChar(50)
  bizcard_theme             String?                  @db.VarChar(100)
  bizcard_type              BizcardType              @default(virtual)
  linked_account            BigInt?
  is_merged                 Boolean                  @default(false)
  deactivated_flag          Boolean                  @default(false)
  merged_at                 DateTime?
  qr_code_url               String?                  @db.VarChar(1024)
  qr_code_generated_at      DateTime?
  qr_code_last_accessed     DateTime?
  scan_count                Int                      @default(0)
  portfolio_url             String?                  @db.VarChar(512)
  is_blank                  Boolean                  @default(false)
  claimed_at                DateTime?
  claimed_by_user_id        BigInt?
  generated_by_user_id      BigInt?
  generated_at              DateTime                 @default(now())
  created_at                DateTime                 @default(now())
  updated_at                DateTime?
  /// Timestamp of last URL alias change (tracked separately from all updates)
  last_url_alias_changed_at DateTime?
  /// Subscription tier: basic, standard, premium
  subscription_tier         String?                  @db.VarChar(20)
  bizcard_style             String                   @default("polyvinyl") @db.VarChar(20)
  subscription_started_at   DateTime?
  subscription_expires_at   DateTime?
  /// pending_activation, active, expired, cancelled
  subscription_status       String?                  @default("pending_activation") @db.VarChar(20)
  /// Link to Merchandise for product-tied subscription
  product_id                BigInt?
  auto_renewal_enabled      Boolean                  @default(false)
  last_renewal_at           DateTime?
  portfolio_qr_code_url     String?                  @db.VarChar(1024)
  vcf_file_url              String?                  @db.VarChar(1024)
  /// When a SuperAdmin manually marks this blank card as physically distributed (before user registration)
  manually_distributed_at   DateTime?
  /// Which SuperAdmin user performed the manual distribution action
  manually_distributed_by   BigInt?
  show_cover_photo          Boolean                  @default(true)
  show_inquiry_card         Boolean                  @default(true)
  /// Soft-delete timestamp; set when Super Admin moves the owning user to Recycle Bin
  deleted_at                DateTime?
  /// Label shown next to contact/social icons on the public portfolio: "platform" or "link"
  contact_link_label        String                   @default("link") @db.VarChar(16)
  addresses                 Address[]
  claimedByUser             User?                    @relation("BizcardClaimedBy", fields: [claimed_by_user_id], references: [user_id])
  company                   Company?                 @relation(fields: [company_id], references: [company_id])
  generatedByUser           User?                    @relation("BizcardGeneratedBy", fields: [generated_by_user_id], references: [user_id])
  linkedBizcard             Bizcard?                 @relation("BizcardLinkedAccount", fields: [linked_account], references: [bizcard_id])
  mergedBizcards            Bizcard[]                @relation("BizcardLinkedAccount")
  user                      User?                    @relation(fields: [user_id], references: [user_id])
  mergeHistoryAsBlank       BizcardMergeHistory[]    @relation("BlankBizcard")
  mergeHistoryAsVirtual     BizcardMergeHistory[]    @relation("VirtualBizcard")
  marketplaceSubscription   BizcardSubscription?
  blogs                     Blog[]
  connections               Connection[]
  inquiries                 Inquiry[]
  products                  Product[]
  services                  Service[]
  socials                   Social[]
  subscriptionUpgradeLogs   SubscriptionUpgradeLog[] @relation("BizcardUpgradeLogs")
  qrCodeScans               QRCodeScan[]

  @@index([user_id])
  @@index([url_alias])
  @@index([serial_id])
  @@index([email])
  @@index([company_id])
  @@index([bizcard_type])
  @@index([deactivated_flag])
  @@index([is_merged])
  @@index([is_blank])
  @@index([claimed_at])
  @@index([generated_at])
  @@index([subscription_tier])
  @@index([subscription_status])
  @@index([subscription_expires_at])
  @@index([product_id])
  @@index([linked_account], map: "Bizcard_linked_account_fkey")
  @@index([claimed_by_user_id], map: "Bizcard_claimed_by_user_id_fkey")
  @@index([generated_by_user_id], map: "Bizcard_generated_by_user_id_fkey")
  @@index([qr_code_url(length: 768)])
  @@index([qr_code_generated_at])
  @@index([qr_code_last_accessed])
  @@index([scan_count])
  @@index([deleted_at])
  @@fulltext([bizcard_name, first_name, last_name, description, bio])
  @@map("Bizcard")
}

