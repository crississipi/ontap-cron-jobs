model SubscriptionUpgradeLog {
  id             BigInt            @id @default(autoincrement())
  bizcard_id     BigInt
  from_plan_id   BigInt?
  to_plan_id     BigInt
  upgrade_type   String            @db.VarChar(30)
  amount_paid    Decimal?          @db.Decimal(10, 2)
  billing_cycle  String?           @db.VarChar(20)
  effective_date DateTime
  expiry_date    DateTime?
  order_id       BigInt?
  created_at     DateTime          @default(now())
  bizcard        Bizcard           @relation("BizcardUpgradeLogs", fields: [bizcard_id], references: [bizcard_id], onDelete: Cascade)
  fromPlan       SubscriptionPlan? @relation("UpgradeFrom", fields: [from_plan_id], references: [id])
  order          ShopOrder?        @relation(fields: [order_id], references: [id])
  toPlan         SubscriptionPlan  @relation("UpgradeTo", fields: [to_plan_id], references: [id])

  @@index([bizcard_id, effective_date])
  @@index([order_id])
  @@index([from_plan_id], map: "SubscriptionUpgradeLog_from_plan_id_fkey")
  @@index([to_plan_id], map: "SubscriptionUpgradeLog_to_plan_id_fkey")
}

model WebhookEvent {
